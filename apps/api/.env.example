# Local docker Postgres (default) OR Supabase direct connection (port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
SUPABASE_URL=
SUPABASE_ANON_KEY=  # for Storage/Auth (db/storage.py)
OPENALEX_MAILTO=your-email@example.com

# Sponsor providers (PRD §37) — unset = stub/default. Wire in providers/registry.py.
LLM_PROVIDER=stub            # stub | openai
OPENAI_API_KEY=
SEARCH_PROVIDER=stub         # auto: Elastic when ELASTIC_URL is set
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=paper-atlas
RESEARCH_DATA_PROVIDER=openalex   # openalex (only impl)
INFERENCE_OPTIMIZER=token_company  # token_company (default, no key needed) | off
SPEECH_PROVIDER=stub         # stub | deepgram
DEEPGRAM_API_KEY=
TOKEN_COMPANY_API_KEY=
